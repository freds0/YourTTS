{
    "model": "vits",
    "run_name": "yourtts_vctk_lightning",
    "output_path": "outputs/yourtts_vctk_lightning/",

    "model_args": {
        "num_chars": 100,
        "out_channels": 513,
        "spec_segment_size": 32,
        "hidden_channels": 192,
        "hidden_channels_ffn_text_encoder": 768,
        "num_heads_text_encoder": 2,
        "num_layers_text_encoder": 10,
        "kernel_size_text_encoder": 3,
        "dropout_p_text_encoder": 0.1,
        "dropout_p_duration_predictor": 0.5,
        "kernel_size_posterior_encoder": 5,
        "dilation_rate_posterior_encoder": 1,
        "num_layers_posterior_encoder": 16,
        "kernel_size_flow": 5,
        "dilation_rate_flow": 1,
        "num_layers_flow": 4,
        "resblock_type_decoder": "1",
        "resblock_kernel_sizes_decoder": [3, 7, 11],
        "resblock_dilation_sizes_decoder": [[1, 3, 5], [1, 3, 5], [1, 3, 5]],
        "upsample_rates_decoder": [8, 8, 2, 2],
        "upsample_initial_channel_decoder": 512,
        "upsample_kernel_sizes_decoder": [16, 16, 4, 4],
        "periods_multi_period_discriminator": [2, 3, 5, 7, 11],
        "use_sdp": true,
        "noise_scale": 1.0,
        "inference_noise_scale": 0.667,
        "length_scale": 1.0,
        "noise_scale_dp": 1.0,
        "inference_noise_scale_dp": 1.0,
        "max_inference_len": null,
        "init_discriminator": true,
        "use_spectral_norm_disriminator": false,
        "use_speaker_embedding": false,
        "use_d_vector_file": true,
        "d_vector_file": ["outputs/yourtts_vctk_lightning/speakers.json"],
        "d_vector_dim": 512,
        "use_speaker_encoder_as_loss": true,
        "speaker_encoder_config_path": "models/speaker_encoder/config_se.json",
        "speaker_encoder_model_path": "models/speaker_encoder/model_se.pth.tar",
        "use_language_embedding": false,
        "embedded_language_dim": 4,
        "num_speakers": 0,
        "condition_dp_on_speaker": true
    },

    "audio": {
        "fft_size": 1024,
        "win_length": 1024,
        "hop_length": 256,
        "sample_rate": 16000,
        "num_mels": 80,
        "mel_fmin": 0,
        "mel_fmax": null,
        "do_trim_silence": true,
        "trim_db": 45,
        "signal_norm": false,
        "do_sound_norm": false,
        "do_rms_norm": false,
        "db_level": null,
        "power": 1.5,
        "griffin_lim_iters": 60
    },

    "batch_size": 32,
    "eval_batch_size": 16,
    "num_loader_workers": 8,
    "num_eval_loader_workers": 4,
    "run_eval": true,
    "test_delay_epochs": 10,

    "epochs": 1000,
    "text_cleaner": "phoneme_cleaners",
    "use_phonemes": true,
    "phoneme_language": "en-us",
    "phoneme_cache_path": "outputs/yourtts_vctk_lightning/phoneme_cache",
    "compute_input_seq_cache": false,
    "add_blank": true,
    "enable_eos_bos_chars": false,
    "use_noise_augment": true,

    "lr_gen": 2e-4,
    "lr_disc": 2e-4,
    "beta1_gen": 0.8,
    "beta2_gen": 0.99,
    "beta1_disc": 0.8,
    "beta2_disc": 0.99,
    "wd_gen": 1e-6,
    "wd_disc": 1e-6,

    "lr_scheduler_gen": "ExponentialLR",
    "lr_scheduler_gen_params": {
        "gamma": 0.999875,
        "last_epoch": -1
    },
    "lr_scheduler_disc": "ExponentialLR",
    "lr_scheduler_disc_params": {
        "gamma": 0.999875,
        "last_epoch": -1
    },

    "grad_clip": [1000.0, 1000.0],

    "kl_loss_alpha": 1.0,
    "disc_loss_alpha": 1.0,
    "gen_loss_alpha": 1.0,
    "feat_loss_alpha": 1.0,
    "mel_loss_alpha": 45.0,
    "dur_loss_alpha": 1.0,
    "speaker_encoder_loss_alpha": 9.0,

    "print_step": 25,
    "plot_step": 100,
    "log_model_step": 1000,
    "save_step": 5000,
    "save_n_checkpoints": 5,
    "save_checkpoints": true,
    "target_loss": null,
    "print_eval": true,

    "use_phonemes": true,
    "phonemizer": "espeak",
    "phoneme_language": "en-us",

    "test_sentences": [
        ["It took me quite a long time to develop a voice, and now that I have it I'm not going to be silent."],
        ["Be a voice, not an echo."],
        ["I'm sorry Dave. I'm afraid I can't do that."],
        ["This cake is great. It's so delicious and moist."],
        ["Prior to November 22, 1963."]
    ],

    "datasets": [
        {
            "name": "vctk",
            "path": "datasets/VCTK-Corpus/",
            "meta_file_train": "metadata_train.csv",
            "meta_file_val": "metadata_val.csv"
        }
    ],

    "eval_split_size": 0.01,
    "eval_split_max_size": 256,
    "min_audio_len": 1,
    "max_audio_len": 220500,
    "min_text_len": 1,
    "max_text_len": 325,

    "mixed_precision": true,

    "characters": {
        "characters_class": "TTS.tts.utils.text.characters.IPAPhonemes",
        "pad": "<PAD>",
        "eos": "<EOS>",
        "bos": "<BOS>",
        "blank": "<BLNK>",
        "characters": "ɑɐɒæɓʙβɔɕçɗɖðʤəɘɚɛɜɝɞɟʄɡɠɢʛɦɧħɥʜɨɪʝɭɬɫɮʟɱɯɰŋɳɲɴøɵɸθœɶʘɹɺɾɻʀʁɽʂʃʈʧʉʊʋⱱʌɣɤʍχʎʏʑʐʒʔʡʕʢǀǁǂǃˈˌːˑʼʴʰʱʲʷˠˤ˞↓↑→↗↘'̩'ᵻ",
        "punctuations": "!'(),-.:;? ",
        "phonemes": "ɑɐɒæɓʙβɔɕçɗɖðʤəɘɚɛɜɝɞɟʄɡɠɢʛɦɧħɥʜɨɪʝɭɬɫɮʟɱɯɰŋɳɲɴøɵɸθœɶʘɹɺɾɻʀʁɽʂʃʈʧʉʊʋⱱʌɣɤʍχʎʏʑʐʒʔʡʕʢǀǁǂǃˈˌːˑʼʴʰʱʲʷˠˤ˞↓↑→↗↘'̩'ᵻ"
    }
}
